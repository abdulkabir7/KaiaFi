# Arc mainnet contract deployment (local .env only; never expose PRIVATE_KEY in Vite/Vercel)
ARC_RPC_URL=https://rpc.mainnet.arc.io
PRIVATE_KEY=
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Set in the Vercel project only after the Arc vault has been deployed.
# This address is public configuration, not a secret.
VITE_ARC_USDC_VAULT_ADDRESS=
